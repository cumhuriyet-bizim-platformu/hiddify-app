# Forbidden-endpoint allowlist for the app fork (cumhuriyet-bizim-platformu/hiddify-app, branch derbent).
# Format: <path ERE> TAB <line ERE> TAB <justification>. Every entry needs a justification.
# Entries moved from the monorepo allowlist (ruling PB7: prefix apps/hiddify-app/ stripped, only entries the scan uses).
^lib/core/model/constants\.dart$	static const (githubUrl|licenseUrl) = "https://github\.com/hiddify/hiddify-next	source code and license credit links in the about page and intro line (credits are kept, spec section 2); opened only on click
^linux/packaging/app\.hiddify\.com\.appdata\.xml$	app\.hiddify\.com|linux@hiddify\.com	AppStream app id and update contact: branding metadata, no URL and nothing is fetched
^linux/packaging/(deb|rpm|appimage)/make_config\.yaml$	app\.hiddify\.com|linux@hiddify\.com|^# url: https://github\.com/hiddify/hiddify-app	package id, maintainer email and a commented-out line: branding metadata, nothing is fetched
^linux/packaging/appimage/AppRun$	StartupWMClass=app\.hiddify\.com	window class id matching the app id: branding metadata, nothing is fetched
^android/app/build\.gradle$	applicationId "app\.hiddify\.com"	branding metadata (application id), changes in the branding phase
^android/app/src/main/res/xml/shortcuts\.xml$	android:targetPackage="app\.hiddify\.com"	branding metadata (application id), changes in the branding phase
^linux/CMakeLists\.txt$	set\(APPLICATION_ID "app\.hiddify\.com"\)	branding metadata (application id), changes in the branding phase
^macos/Runner/Configs/AppInfo\.xcconfig$	PRODUCT_BUNDLE_IDENTIFIER = app\.hiddify\.com|PRODUCT_COPYRIGHT = Copyright © 2023 hiddify\.com\. All rights reserved\.	branding metadata (bundle id, copyright), changes in the branding phase
^windows/runner/Runner\.rc$	Copyright \(C\) 2023 Hiddify\.com\. All rights reserved\.	branding metadata (copyright string), changes in the branding phase
^ios/Base\.xcconfig$	BASE_BUNDLE_IDENTIFIER=apple\.hiddify\.com	branding metadata (iOS bundle id), changes in the branding phase
^ios/exportOptions\.plist$	apple\.hiddify\.com	branding metadata (iOS bundle ids / provisioning names), changes in the branding phase
^ios/HiddifyPacketTunnel/SingBox/ExtensionProvider\.swift$	subsystem: "apple\.hiddify\.com\.HiddifyPacketTunnel"	branding metadata (os_log subsystem = bundle id), changes in the branding phase
^ios/Runner\.xcodeproj/xcshareddata/xcschemes/HiddifyPacketTunnel\.xcscheme$	BundleIdentifier = "apple\.hiddify\.com"	branding metadata (bundle id in Xcode scheme), changes in the branding phase
^lib/hiddifycore/core_interface/core_interface_mobile\.dart$	^[[:space:]]*// await start\("/sdcard/Android/data/app\.hiddify\.com/	code comment with an on-device path (bundle id), not executed
^lib/features/profile/data/profile_parser\.dart$	// See https://github\.com/hiddify/hiddify-app/issues/1974	code comment citing an upstream issue, not fetched
# Task 24 (plan step 3d) app-id entry, narrowed per file (fix round 1, I1).
^\.github/workflows/build\.yml$	^[[:space:]]*(packageName|bundle-id): app\.hiddify\.com(\.SingBoxPacketTunnel)?$	Android package name and iOS bundle identifiers passed to the store-upload steps; identifiers, not URLs, nothing is fetched; change in the branding phase (group D)
^Makefile$	/a StartupWMClass=app\.hiddify\.com'	desktop-entry window class set to the application id while packaging the AppImage; an identifier, nothing is fetched; changes in the branding phase (group D)
# Rulings PB9 and PB10.
^\.github/workflows/build\.yml$	uses: hiddify/signtool-code-sign-sha256@edf131ad76c36ab1a9b468cdfa02acafd8a2a499( |$)	spec §6 pin-to-SHA option; forking into the org is an owner decision (Windows release signing step, pinned to a full commit SHA)
^packages/flutter_circle_flags/pubspec\.yaml$	^repository: https://github\.com/hiddify-com/flutter_circle_flags$	vendored upstream package metadata (pub repository field); the package is a local path dependency, nothing is fetched
^assets/fonts/emoji_source\.txt$	^https://github\.com/hiddify-com/noto-emoji$	attribution text naming where the bundled Emoji.ttf subset came from; not an asset in pubspec and nothing is fetched
